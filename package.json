{
  "name": "chesspresso-eslestirme",
  "productName": "Chesspresso Eşleştirme",
  "version": "1.1.0",
  "description": "İsviçre sistemi satranç turnuvaları için eşleştirme ve sıralama programı",
  "main": "main.js",
  "author": "etgazavalsiz",
  "license": "MIT",
  "homepage": "https://github.com/etgazavalsiz/chesspresso-eslestirme",
  "repository": {
    "type": "git",
    "url": "https://github.com/etgazavalsiz/chesspresso-eslestirme.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.etgazavalsiz.chesspresso",
    "productName": "Chesspresso Eşleştirme",
    "executableName": "chesspresso",
    "copyright": "MIT Lisansı — github.com/etgazavalsiz/chesspresso-eslestirme",
    "files": ["package.json", "index.html", "main.js", "build/icon.png"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Chesspresso-Kurulum-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Chesspresso Eşleştirme",
      "uninstallDisplayName": "Chesspresso Eşleştirme",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerLanguages": ["tr_TR"],
      "language": "1055",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  }
}
